# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas (replica set — later phases use multi-document transactions)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=testolife
# Optional: only if startup fails with "querySrv ECONNREFUSED" (local DNS can't resolve SRV records)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=<at-least-32-random-characters>

# Allowed browser origins for CORS and Socket.IO (comma separated)
CLIENT_URL=http://localhost:3000

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=100kb

# Auth
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_MAX=60
REFRESH_REUSE_GRACE_SECONDS=10
# Which proxies may set X-Forwarded-For: "loopback" (Next.js on this machine), "1" behind one Nginx, ...
TRUST_PROXY=loopback

# Password for the demo accounts created by npm run seed (8+ chars, letters and numbers). Dev only.
DEMO_PASSWORD=

# Optional: AI assistant (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

HOSPITAL_NAME=Testolife Hospital
HOSPITAL_ADDRESS=Arshinagar, Amtola, Near Bosila Bridge, Keraniganj, Dhaka
HOSPITAL_EMERGENCY_PHONE=999
HOSPITAL_OPD_HOURS=Saturday–Thursday, 9:00 AM – 9:00 PM

# Optional integrations
UPLOAD_FOLDER=public/uploads
max_file_size=5
STRIPE_SECRET_KEY=

# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Any random string of 16+ characters; the TV opens /queue-display?key=<this>
QUEUE_DISPLAY_KEY=
