{
  "name": "testolife-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Testolife — AI-powered hospital operating system (API)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,json,env --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/reset-hospital-data.ts",
    "demo:live": "tsx scripts/demo-live-queue.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src scripts tests --ext .ts",
    "lint:fix": "eslint src scripts tests --ext .ts --fix",
    "format": "prettier --write \"{src,scripts,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.ts\"",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "permissions:export": "npm run shared:export",
    "shared:export": "tsx scripts/export-permissions.ts",
    "pdf:setup": "puppeteer browsers install chrome-headless-shell",
    "eval:chatbot": "tsx scripts/eval-chatbot.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@google/genai": "^2.24.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-useragent": "^1.0.15",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "http-status": "^1.7.3",
    "jsonwebtoken": "^9.0.2",
    "lint-staged": "^15.1.0",
    "moment": "^2.30.1",
    "mongoose": "^8.5.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.12.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.13.1",
    "socket.io": "^4.7.5",
    "stripe": "^17.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/express-useragent": "^1.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.13.0",
    "@types/semver": "^7.5.8",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2"
  }
}
